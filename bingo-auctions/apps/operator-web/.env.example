NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Operator Connect accounts use Standard direct-create (no OAuth
# client_id needed). Bidder + operator-Pro Price IDs are stored per-operator
# in the operators table — they are not env vars.
#
# Platform subscription Price IDs (Starter $99/mo, Pro $299/mo) ARE env
# vars — these are platform-wide prices that all operators see. Create
# them in the Stripe dashboard (Products → Add product → recurring monthly
# price) and paste the price_xxx IDs here.
# Stripe key resolution lives in apps/operator-web/src/lib/stripe-keys.ts.
#
# Set BOTH on every deployment target (CF Worker secret + local .env.local):
#   STRIPE_SECRET_KEY        sk_test_… or sk_live_…  (server-only, NEVER ship)
#   STRIPE_PUBLISHABLE_KEY   pk_test_… or pk_live_…  (server reads + passes to
#                                                     client via prop)
#
# CRITICAL: secret + publishable MUST share a mode (test or live). Mixing
# them silently breaks Stripe.js confirm flows. The helper logs CRITICAL on
# every isolate init if it detects a mismatch — check CF observability
# after any key rotation.
#
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is DEPRECATED. The codebase used to
# read it directly from client components; that was the root cause of the
# 2026-05-22 launch lockout (CF Worker had STRIPE_PUBLISHABLE_KEY set but
# not the NEXT_PUBLIC_ alias, so client code received an empty string).
# The helper still falls back to it for one deploy cycle to ease migration,
# then we drop the fallback.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook secrets. With Accounts v2 routing, Stripe splits events across
# two destinations (Your account + Connected accounts), each with its own
# signing secret. Set both so the handler accepts events from either.
STRIPE_WEBHOOK_SECRET_CONNECT=
STRIPE_WEBHOOK_SECRET_PLATFORM=
# Legacy single-secret slot — kept for compatibility, used as a fallback.
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Auction engine (BullMQ on Redis)
REDIS_URL=

# Observability — server DSN is private, client DSN is public.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# LotTR-Pro AI lookups. Server-side only — no NEXT_PUBLIC_ prefix.
# Without OPENROUTER_API_KEY, /api/lottr/* routes return 503 and the
# LotTR-Pro UI shows a config-missing banner. Get a key at
# https://openrouter.ai/keys.
#
# OpenRouter is the canonical AI provider since 2026-05-24 (audit PERF-8).
# It fronts Gemini Flash (cheap default), gpt-4o-search-preview / Sonar
# (web-search-grounded tasks), and Claude Haiku/Sonnet (escalation tiers).
# Model routing per task lives in packages/domain-lotting/src/ai/llm.ts.
OPENROUTER_API_KEY=

# Legacy direct-Anthropic key. Still read by the @deprecated callAnthropic
# path in domain-lotting/src/ai/anthropic.ts, but no active in-tree code
# invokes it. Safe to leave blank; will be removed in a follow-up PR.
ANTHROPIC_API_KEY=

# Two-domain split (migration 0109, 2026-05-22).
#
# SUPER_ADMIN_EMAILS — comma-separated allowlist of users who can reach
# /admin/requests + /admin/invites + mint operator invitation tokens.
# In production: set via `wrangler secret put SUPER_ADMIN_EMAILS --name bingo-web`.
# Currently scoped to Michael only.
SUPER_ADMIN_EMAILS=
# OPERATORS_SIGNUP_BASE_URL — base URL used by the /admin/* pages when
# they build invite URLs ({base}/signup?token=…). Defaults to
# https://bingoauctions.com if unset. Override in dev when serving
# the operators host locally (e.g. http://operators.localhost:3003).
OPERATORS_SIGNUP_BASE_URL=

# Admin Help (console). Fail closed. Unset or any value other than true = off.
# Do not set true in production; building these tools is not permission to
# turn Admin Help or Staff Help on.
ADMIN_HELP_ENABLED=

# Growth admin hub (scope 10 / #930). Server-only, fail closed. Unset or any
# value other than true/1 leaves today's admin nav and routes unchanged.
GROWTH_HUB_ENABLED=

# Scope 04 / #893 cash+credit buckets on bidder_credits. Fail closed. Unset or
# any value other than true/1 keeps today's single-pool credit spend. Do not
# set true in production; building dark is not a money-flag go-live.
BIDDER_CREDIT_BUCKETS_ENABLED=
