{
  "name": "@auction-platform/operator-web",
  "version": "0.0.0",
  "private": true,
  "description": "Operator console — Next.js 16 App Router. Onboarding, lot/auction management, warehouse + bin editor, pickup operations, payouts, disputes.",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node ../../scripts/generate-legal-content.mjs",
    "build": "next build",
    "precf:build": "node ../../scripts/generate-legal-content.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "cf:build": "next build && opennextjs-cloudflare build",
    "cf:preview": "wrangler pages dev .open-next",
    "cf:deploy": "wrangler pages deploy .open-next/assets --project-name bingo-web"
  },
  "dependencies": {
    "@auction-platform/domain-lotting": "*",
    "@auction-platform/image-enrichment": "*",
    "@auction-platform/shared": "*",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "next": "^16.2.6",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.372.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "twilio": "^6.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.19.17",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.2.6",
    "typescript": "~5.9.3",
    "wrangler": "^4.94.0",
    "vitest": "^2.1.0"
  }
}
