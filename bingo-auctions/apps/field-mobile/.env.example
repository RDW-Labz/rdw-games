# BinGo Staff — field app for operator staff. Same Supabase project as
# bidder-mobile (one tenant, two surfaces). Use the LAN IP of your
# machine when running on a real device, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Operator-web base URL — proxy endpoint for AI calls. The mobile app
# never holds AI keys directly; OpenRouter / Anthropic calls go through
# operator-web's /api/lottr/* routes which validate the Supabase JWT
# and forward to domain-lotting server-side.
#
# Local dev: point at your running operator-web dev server.
# Production: point at your deployed operator-web URL (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://your-operator-web-deployment.example.com

# Optional — leave blank unless testing analytics / errors live.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=
