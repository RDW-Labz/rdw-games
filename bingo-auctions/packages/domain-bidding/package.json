  "dependencies": {
    "@auction-platform/shared": "*",
    "@auction-platform/design-system": "*",
    "@auction-platform/supabase-client": "*"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo-haptics": "*",
    "expo-image": "*",
