    "./BuyNowSheet": "./src/components/BuyNowSheet.tsx",
    "./LiveBidTicker": "./src/components/LiveBidTicker.tsx",
    "./PhotoCarousel": "./src/components/PhotoCarousel.tsx",
    "./PhotoLightbox": "./src/components/PhotoLightbox.tsx",
    "./WatchlistToggle": "./src/components/WatchlistToggle.tsx",
    "./RecentWinsRail": "./src/components/RecentWinsRail.tsx",
    "./useCategories": "./src/hooks/useCategories.ts",
    "./recentlyViewed": "./src/stores/recentlyViewed.ts",
    "./savedSearches": "./src/stores/savedSearches.ts"
