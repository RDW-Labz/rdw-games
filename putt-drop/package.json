{
  "name": "putt-drop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "build:test": "vite build --mode test --outDir build/test",
    "test": "vitest run",
    "smoke": "npm run build:test && node scripts/smoke.mjs && node scripts/smoke-ios.mjs && node scripts/taps-strict.mjs",
    "smoke:ios": "npm run build:test && node scripts/smoke-ios.mjs",
    "taps": "npm run build:test && node scripts/taps-strict.mjs",
    "check-levels": "tsx scripts/check-levels.ts",
    "capture": "npm run build:test && node scripts/capture-screens.mjs",
    "perf": "npm run build:test && node scripts/perf.mjs",
    "cleanup:orphans": "node -e \"import('./scripts/lib/harness.mjs')\""
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "cordova-plugin-purchase": "13.18.0",
    "phaser": "4.2.1",
    "zzfx": "1.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "playwright": "1.64.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
