# Runtime state — regenerated by engine/dangling.py, not source
engine/state.db
engine/state.db-journal
engine/state.db-wal
engine/state.db-shm
engine/sweep.log
*.log

# Lane markers and per-report triage memory — local state, rebuilt by the lane that owns it
engine/.autofile-block
engine/.triage-state.json

# Scratch
*.tmp
__pycache__/
.DS_Store

# Scope data — 20 MB of platform JSON, refetched by engine/programs.py sync
engine/data/

# Client deliverables — never commit real client data
engine/audits/

# Board snapshot is regenerated every morning by engine/board.py --write
reports/BOARD.md
# screen captures are evidence for a conversation, not history: the page they show is gone by tomorrow
evidence-takeover/shots/

# Browser profiles and DB snapshots are secrets/state — never source
engine/profiles/
engine/state.db.bak*
engine/*.bak-*
engine/.kyc.json
